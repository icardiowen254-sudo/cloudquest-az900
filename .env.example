# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Find both values in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public "anon" (or "publishable") key. It is safe in the browser because Row Level Security protects the data.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Optional: show "Continue with Google". Enable the Google provider in Supabase first.
VITE_ENABLE_GOOGLE_AUTH=false
